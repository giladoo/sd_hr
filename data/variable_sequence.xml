<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Sequences for lead mining requests -->
        <record id="ir_sequence_sd_hr_variables" model="ir.sequence">
            <field name="name">SD HR Variables</field>
            <field name="code">sd_hr.variables</field>
            <field name="implementation">no_gap</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_next_actual">1000</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sd_hr_doc_template_00" model="sd_hr.doc_template">
            <field name="name">Resume Color</field>
            <field name="variable_no">0010</field>
        </record>

        <record id="sd_hr_doc_template_01" model="sd_hr.doc_template">
            <field name="name">Resume BW</field>
            <field name="variable_no">0011</field>
        </record>

    </data>
</odoo>