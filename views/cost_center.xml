<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cost_center_list" model="ir.ui.view">
        <field name="name">Cost Center</field>
        <field name="model">sd_hr.cost_center</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />

            </list>
        </field>
    </record>

    <record id="cost_center_search" model="ir.ui.view">
        <field name="name">Cost Center</field>
        <field name="model">sd_hr.cost_center</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>

            </search>
        </field>
    </record>


    <!--    TODO: menu can be in technical section of setting menu-->
    <record id="cost_center_action" model="ir.actions.act_window">
        <field name="name">Report Cost Center</field>
        <field name="res_model">sd_hr.cost_center</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
            id="cost_center_menu"
            name="Cost Center"
            parent="sd_hr_menu_config_employee"
            action="cost_center_action"
            sequence="6"/>

</odoo>
