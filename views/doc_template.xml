<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="doc_template_list" model="ir.ui.view">
        <field name="name">Document Template</field>
        <field name="model">sd_hr.doc_template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="variable_no" readonly="1"/>
                <field name="name"/>
                <field name="template_file"/>

            </list>
        </field>
    </record>




    <record id="doc_template_action" model="ir.actions.act_window">
        <field name="name">Document Templates</field>
        <field name="res_model">sd_hr.doc_template</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
            id="doc_template_menu"
            name="Doc Templates"
            parent="hr.menu_hr_employee_payroll"
            action="doc_template_action"
            sequence="1"/>

</odoo>
