<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="job_plan_list" model="ir.ui.view">
        <field name="name">job_plan</field>
        <field name="model">sd_hr.job_plan</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="version" />
                <field name="record_date" />
                <field name="job_id" />
                <field name="plan" />
                <field name="actual" />


            </list>
        </field>
    </record>

    <record id="job_plan_search" model="ir.ui.view">
        <field name="name">job_plan</field>
        <field name="model">sd_hr.job_plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="version"/>

            </search>
        </field>
    </record>


    <!--    TODO: menu can be in technical section of setting menu-->
    <record id="job_plan_action" model="ir.actions.act_window">
        <field name="name">job_plan</field>
        <field name="res_model">sd_hr.job_plan</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
            id="job_plan_menu"
            name="Job Plan"
            parent="hr.menu_config_employee"
            action="job_plan_action"
            sequence="6"
            groups="hr.group_hr_manager"/>

</odoo>
