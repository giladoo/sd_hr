<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="employee_import_wizard" model="ir.ui.view">
        <field name="name">Employee Import</field>
        <field name="model">sd_hr.employee_import</field>
        <field name="arch" type="xml">
            <form create="0">
                <field name="excel_file_name" invisible="1"/>
                <field name="excel_file" filename="excel_file_name" widget="binary"/>
            <footer>
                <button name="import_file" string="Import" type="object" class="btn btn-primary"/>
                <button special="cancel" string="close" class="btn btn-secondary"/>
            </footer>
            </form>
        </field>
    </record>

    <record id="employee_import_action" model="ir.actions.act_window">
        <field name="name">Employee Import</field>
        <field name="res_model">sd_hr.employee_import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

    <menuitem id="employee_import_menu"
              name="Employee Immport"
              parent="hr.menu_hr_employee_payroll"
              sequence="2"
              action="employee_import_action"/>


</odoo>
